# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres connection string. The docker-compose.yml in this repo spins up
# a matching local database on port 5432 with these same credentials.
DATABASE_URL="postgresql://devmatch:devmatch@localhost:5432/devmatch"

# Secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Port the custom server (server.ts) listens on.
PORT=3000
