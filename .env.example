# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres connection string. The docker-compose.yml in this repo spins up
# a matching local database on port 5434 with these same credentials
# (not the Postgres-default 5432 - see IMPLEMENTATION.md's port note).
DATABASE_URL="postgresql://devmatch:devmatch@localhost:5434/devmatch"

# Secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Port the custom server (server.ts) listens on.
PORT=3000

# API key for the chatbot widget (components/chatbot.tsx), from
# https://console.groq.com/keys. Leave unset to disable the chatbot.
GROQ_API_KEY=""

# Optional: override the Groq model used by the chatbot. Defaults to
# openai/gpt-oss-120b. See https://console.groq.com/docs/models for models
# your key has access to.
GROQ_MODEL=""
